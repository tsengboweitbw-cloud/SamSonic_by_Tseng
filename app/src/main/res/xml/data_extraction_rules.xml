<?xml version="1.0" encoding="utf-8"?>
<!-- Saved servers are encrypted with a Keystore key that doesn't move between devices, so a
     restored copy could never be read: keep it out of backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="samsonic_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="samsonic_session.xml" />
    </device-transfer>
</data-extraction-rules>
